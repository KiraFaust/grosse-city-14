ent-RadSignC17 = знак "Радиация"
    .desc = На знаке изображён символ радиоактивной опасности, который информирует о радиоактивной опасности за знаком. Может, не стоит туда идти?
ent-CheSignC17 = знак "Химическая опасность"
    .desc = На знаке изображён символ химической опасности, который информирует о химической опасности за знаком. Может, не стоит туда идти?
ent-RoadSignC17 = автобусная остановка
    .desc = Знак обозначающий автобусную остановку.
    .suffix = Дорожный знак
ent-RoadSign2C17 = знак "Стоп"
    .desc = Знак обозначающий остановку.
    .suffix = { ent-RoadSignC17.suffix }
ent-RoadSign3C17 = знак "Одно Направление"
    .desc = Знак обозначающий что тут одно направление.
    .suffix = { ent-RoadSignC17.suffix }
ent-RoadSign4C17 = знак "Нет Пешеходного прохода"
    .desc = Знак обозначающий что тут нет проходов для пешеходов.
    .suffix = { ent-RoadSignC17.suffix }
ent-RoadSign5C17 = знак "Не Поворачивать"
    .desc = Знак обозначающий что тут нельзя поворачивать.
    .suffix = { ent-RoadSignC17.suffix }
ent-RoadSign6C17 = Улица
    .desc = Знак обозначающий что тут такая-то улица.
    .suffix = { ent-RoadSignC17.suffix }
